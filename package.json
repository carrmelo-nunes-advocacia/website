    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-security": "4.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10",
      "sharp": ">=0.35.0",
      "brace-expansion@1": "1.1.18"
